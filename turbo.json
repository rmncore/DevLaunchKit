{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "passThroughEnv": [
        "DATABASE_URL",
        "AUTH_BASE_URL",
        "AUTH_SECRET_KEY",
        "DEVLAUNCHKIT_ADMIN_DEMO",
        "PORT",
        "NEXT_TELEMETRY_DISABLED"
      ],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {},
    "test": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
